<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="scope_ai_agent_run" model="ir.access">
        <field name="name">AI run scope</field>
        <field name="model_id" ref="model_ai_agent_run" />
        <field name="operation">crud</field>
        <field
            name="domain"
        >[] if user.has_group('base.group_system') else ['|', ('agent_id.user_id', '=', user.id), ('agent_id.reviewer_ids', 'in', [user.id])]</field>
    </record>
