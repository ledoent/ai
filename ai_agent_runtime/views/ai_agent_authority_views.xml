<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ai_agent_authority_wizard_form" model="ir.ui.view">
        <field name="model">ai.agent.authority.wizard</field>
        <field name="arch" type="xml">
            <form string="Authority decision">
                <group>
                    <field name="operation" readonly="1" />
                    <field
                        name="capability_id"
                        readonly="1"
                        invisible="operation == 'undo'"
                    />
                    <field
                        name="call_id"
                        readonly="1"
                        invisible="operation != 'undo'"
                    />
                    <field name="level" invisible="operation != 'manual'" />
                    <field name="reason" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="ai_agent_capability_form" model="ir.ui.view">
        <field name="model">ai.agent.capability</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button
                        name="action_open_manual"
                        string="Set level"
                        type="object"
                        groups="base.group_system"
                    />
                    <button
                        name="action_open_veto"
                        string="Veto"
                        type="object"
                        groups="ai_agent_runtime.group_ai_reviewer"
                    />
                    <button
                        name="action_open_unlock"
                        string="Clear promotion lock"
                        type="object"
                        groups="base.group_system"
                        invisible="not promotion_locked"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="agent_id" />
                        <field name="tool_id" />
                        <field name="granted" />
                        <field name="level" />
                        <field name="promotion_locked" />
                        <field name="epoch" />
                        <field name="epoch_started" />
                        <field name="reason" />
                    </group>
                    <field name="history" />
                </sheet>
            </form>
        </field>
    </record>
    <record id="ai_agent_call_form" model="ir.ui.view">
        <field name="model">ai.agent.call</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button
                        name="action_accept"
                        string="Accept intent / approve call"
                        type="object"
                        groups="ai_agent_runtime.group_ai_reviewer"
                        invisible="state not in ('observed', 'pending')"
                    />
                    <button
                        name="action_reject"
                        string="Reject"
                        type="object"
                        groups="ai_agent_runtime.group_ai_reviewer"
                        invisible="state not in ('observed', 'pending')"
                    />
                    <button
                        name="action_open_undo"
                        string="Request undo"
                        type="object"
                        groups="ai_agent_runtime.group_ai_reviewer"
                        invisible="state != 'dispatched' or undo_state != 'none'"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="run_id" />
                        <field name="sequence" />
                        <field name="tool_name" />
                        <field name="model_name" />
                        <field name="method_name" />
                        <field name="state" />
                        <field name="user_id" />
                        <field name="execution_context" />
                        <field name="capability_id" />
                        <field name="capability_epoch" />
                        <field name="capability_level" />
                        <field name="approver_id" />
                        <field name="undo_state" />
                        <field name="undo_error" invisible="not undo_error" />
                    </group>
                    <field name="args" />
                    <field name="result" />
                    <field name="receipt" />
                    <field name="evidence_ids">
                        <list create="0" delete="0">
                            <field name="kind" />
                            <field name="verdict" />
                            <field name="reviewer_id" />
                            <field name="judged_at" />
                            <field name="epoch" />
                            <field name="reason" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ai_agent_call_list" model="ir.ui.view">
        <field name="model">ai.agent.call</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="run_id" />
                <field name="tool_name" />
                <field name="capability_level" />
                <field name="state" />
                <field name="undo_state" />
            </list>
        </field>
    </record>
    <record id="ai_agent_call_action" model="ir.actions.act_window">
        <field name="name">Agent invocations</field>
        <field name="res_model">ai.agent.call</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_ai_agent_call"
        parent="menu_ai_agent_root"
        action="ai_agent_call_action"
        sequence="6"
    />
</odoo>
